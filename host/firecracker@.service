# One VM. `runner boot <vm>` runs Firecracker for it and holds the VM's lock
# until Firecracker exits; `runner start` and `stop` drive it with systemctl.
# host/install.sh installs this file, and `runner doctor` checks the installed
# copy still matches it.
[Unit]
Description=runner VM %i
After=network.target runner-nat.service

[Service]
User=runner
Group=runner
SupplementaryGroups=kvm
Environment=RUNNER_ROOT=/var/lib/runner
# The credentials a VM may get, each from /etc/credstore/<name>. One that
# isn't there is skipped. Boot hands a VM's to its guest (docs/host.md).
LoadCredential=CLAUDE_CODE_OAUTH_TOKEN
LoadCredential=ANTHROPIC_API_KEY
LoadCredential=GH_TOKEN
# %i, not %I: %I would unescape a VM name's dashes into slashes.
ExecStart=/usr/local/bin/runner boot %i
NoNewPrivileges=yes
# For runner boot to add and remove the VM's tap, and nothing else.
# Firecracker doesn't need it to open the tap, so boot clears it from the
# ambient set before running Firecracker.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
