{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if bash -n \"$CLAUDE_PROJECT_DIR/.claude/temper/state.sh\" 2>/dev/null; then bash \"$CLAUDE_PROJECT_DIR/.claude/temper/state.sh\" show --hook; fi",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if bash -n \"$CLAUDE_PROJECT_DIR/.claude/temper/guard.sh\" 2>/dev/null; then bash \"$CLAUDE_PROJECT_DIR/.claude/temper/guard.sh\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if bash -n \"$CLAUDE_PROJECT_DIR/.claude/temper/secrets.sh\" 2>/dev/null; then bash \"$CLAUDE_PROJECT_DIR/.claude/temper/secrets.sh\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if bash -n \"$CLAUDE_PROJECT_DIR/.claude/temper/handoff.sh\" 2>/dev/null; then bash \"$CLAUDE_PROJECT_DIR/.claude/temper/handoff.sh\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
