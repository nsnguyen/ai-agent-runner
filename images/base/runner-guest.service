[Unit]
Description=runner guest agent: runs commands for the host over vsock
Documentation=https://github.com/nsnguyen/ai-agent-runner

[Service]
# Root, because each request names the user its command runs as.
ExecStart=/usr/local/bin/runner-guest
Restart=always
RestartSec=1
# Each user's tmux server, which sessions live on, is in this unit's cgroup.
# A restart, or the OOM killer taking one command, mustn't end every session.
KillMode=process
OOMPolicy=continue
# The credentials it holds, and every command's, stay in memory: no core dump
# of this agent or of a command it starts ever writes one to the disk.
LimitCORE=0

[Install]
WantedBy=multi-user.target
