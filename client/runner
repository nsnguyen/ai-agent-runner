#!/bin/sh
# runner on the laptop: every command but proxy runs on the KVM host over SSH
# (docs/design.md). The host is anything ssh takes, like runner@kvm-host or an
# alias in ~/.ssh/config: RUNNER_HOST, else the first line of
# ~/.config/runner/host. POSIX sh only, since macOS's /bin/sh runs it.

host=${RUNNER_HOST-}
if [ -z "$host" ] && [ -r "$HOME/.config/runner/host" ]; then
  read -r host <"$HOME/.config/runner/host"
fi
case $host in
'' | -*)
  echo "runner: no host. Set RUNNER_HOST, or put it in ~/.config/runner/host (client/install.sh <host> does)." >&2
  exit 2
  ;;
esac

# ssh hands the remote shell one string, so each argument is quoted for it:
# bare when it's only safe characters, else in single quotes, with ' as '\''.
# quote ARG sets $arg to ARG quoted.
q="'"
quote() {
  arg=$1
  case $arg in
  '' | *[![:alnum:]@%+=:,./_-]*)
    quoted=
    while :; do
      case $arg in
      *"$q"*)
        head=${arg%%"$q"*}
        arg=${arg#*"$q"}
        quoted=$quoted$head$q\\$q$q
        ;;
      *) break ;;
      esac
    done
    arg=$q$quoted$arg$q
    ;;
  esac
}

# proxy runs here, not on the host: localhost:PORT on the laptop becomes PORT
# in the VM, through an ssh tunnel to the host, which reaches the VM's address.
# The tunnel's command is the host's `runner hold`, which holds the VM in use
# until the connection closes, so the VM doesn't idle-sleep under the proxy.
usage="usage: runner proxy <vm> <port>|<local>:<remote>...
  runner proxy dev 3000         localhost:3000 here is dev's port 3000
  runner proxy dev 8080:3000    localhost:8080 here is dev's port 3000"

# port P: whether P is 1 to 65535, written without leading zeros.
port() {
  case $1 in '' | 0* | *[!0-9]* | ??????*) return 1 ;; esac
  [ "$1" -le 65535 ]
}

if [ "${1-}" = proxy ]; then
  case ${2-} in -h | --help)
    echo "$usage"
    exit 0
    ;;
  esac
  if [ $# -lt 3 ] || [ -z "$2" ]; then
    echo "$usage" >&2
    exit 2
  fi
  vm=$2
  shift 2
  for spec; do
    if ! port "${spec%%:*}" || ! port "${spec#*:}"; then
      printf "runner: '%s' isn't a port or local:remote\n%s\n" "$spec" "$usage" >&2
      exit 2
    fi
  done

  # start boots a stopped VM, wakes a sleeping one, and leaves a running one be.
  quote "$vm"
  vmq=$arg
  # No stdin, so keys typed while the VM boots stay in the terminal, and no
  # tty, whose \r would spoil the address.
  # shellcheck disable=SC2029 # $vmq is quoted for the host's shell, here.
  addr=$(ssh -n -T "$host" "runner start $vmq >/dev/null && runner ip $vmq") || exit
  case $addr in '' | *[!0-9.]*)
    echo "runner: the host gave $vm's address as '$addr', which isn't one" >&2
    exit 1
    ;;
  esac
  said=
  for spec; do
    shift
    lport=${spec%%:*}
    rport=${spec#*:}
    # localhost binds loopback alone, even with GatewayPorts set.
    set -- "$@" -L "localhost:$lport:$addr:$rport"
    said="$said, localhost:$lport is $vm's port $rport"
  done
  echo "runner: ${said#, }. Ctrl-C ends it." >&2
  # The hold reads nothing, so no stdin, and keys typed here go nowhere. Ctrl-C
  # or a dropped connection ends ssh, and with it the hold, so the VM's idle
  # time starts again.
  # shellcheck disable=SC2029 # $vmq is quoted for the host's shell, here.
  exec ssh -n -T -o ExitOnForwardFailure=yes "$@" "$host" "runner hold $vmq"
fi

cmd=runner
for a; do
  quote "$a"
  cmd="$cmd $arg"
done

if [ "${1-}" = mcp ]; then
  # No terminal, so stdout carries only JSON-RPC, and no prompt to hang the client.
  exec ssh -T -o BatchMode=yes "$host" "$cmd"
elif [ "${1-}" = export ] && [ -t 1 ]; then
  # The host refuses a terminal on an export's stdout, so it has to see this
  # one, even when stdin isn't one: -tt.
  exec ssh -tt -o LogLevel=ERROR "$host" "$cmd"
elif [ -t 0 ] && [ -t 1 ]; then
  # A tty only when typed at one: piped output would get CRLF and stderr mixed in.
  # LogLevel=ERROR drops ssh's "Connection to … closed." after every command.
  exec ssh -t -o LogLevel=ERROR "$host" "$cmd"
else
  exec ssh "$host" "$cmd"
fi
