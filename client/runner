#!/bin/sh
# runner on the laptop: every command but proxy and hosts runs on a KVM host
# over SSH (docs/design.md). A host is anything ssh takes, like runner@kvm-host
# or an alias in ~/.ssh/config. The hosts are the lines of
# ~/.config/runner/hosts, the first the one MCP goes to, which reaches the
# rest as its peers; without that file, the first line of
# ~/.config/runner/host is the only one; RUNNER_HOST names one host alone.
# With several, a command naming a VM goes to the host that has it (README.md,
# Several hosts), and move's target is passed on as listed, since that host's
# ssh reaches it. A host aws.sh made that a command finds stopped is started
# first, by the aws.sh beside this script (README.md, Day to day), and create
# starts one when no running host has room. POSIX sh only, since macOS's
# /bin/sh runs it.

# No argument or host name is ever a glob.
set -f
conf=$HOME/.config/runner
hosts_file=$conf/hosts
# Where each VM was when every host was last asked: "<vm> <host>" a line.
cache=$HOME/.cache/runner/vms
# Seconds a host gets to answer when every host is asked at once, and ssh's
# options for those asks: no stdin, no prompt, and keepalives, so a host that
# stops answering part way is dropped too.
wait=5
ask="-n -o BatchMode=yes -o ConnectTimeout=$wait -o ServerAliveInterval=$wait -o ServerAliveCountMax=2"

# Options of the host's runner that take a value, so the scan below knows the
# next argument is that value and not the VM. tests/hosts.rs checks that
# every one clap has is here. --run is claude's; --host is the laptop's own.
valued=" --root --keep --creds --from --cpus --mem --disk --kernel --idle --port -n --lines -m --comment --user -s --session -d --dir -e --env --resume --n --run --peer --name --http --url --host "

hosts_usage="usage: runner hosts [add <host> | rm <host>]
  runner hosts                         each host: its VMs, how many are up, its free memory
  runner hosts add runner@kvm-host-2   check it answers, add it to ~/.config/runner/hosts,
                                       and put every host's key on every other
  runner hosts rm kvm-host-2           take it out of the list, and its key out of the others';
                                       its VMs stay on it"

# The options of each host's key line on every other host: only from the
# tailnet, no terminal or forwarding, and `runner peer` in place of any
# command, which runs only `runner mcp` and `runner import <vm> -`
# (src/peers.rs, whose OPTIONS tests/hosts.rs holds this to). The host's name
# ends the line.
peer_opts='from="100.64.0.0/10,fd7a:115c:a1e0::/48",restrict,command="/usr/local/bin/runner peer"'
nl='
'

# What reconcile runs on a host, with $p the options above; $keep the names
# of the hosts whose lines stay, and $fresh the keys whose lines go, a word
# each between spaces; and $add the lines to add. Its authorized_keys loses
# each peer line whose host $keep doesn't name or whose key is in $fresh,
# keeps every other line, like the laptop's, as it is, then gets $add, in
# one move. A peer line is one sshd reads as one: blanks may lead it, and
# tabs part its words. A line of $add whose key another line here has, like
# the laptop's, isn't added, and the edit exits 3 after saying so, since that
# line would lock the other's key into runner peer once it came first.
# shellcheck disable=SC2016 # for the host's shell to expand.
edit='k=$HOME/.ssh/authorized_keys
[ -e "$k" ] || [ -n "$add" ] || exit 0
from=$k
[ -e "$k" ] || from=/dev/null
export add
umask 077
new=$k.new.$$
awk -v p="$p" -v keep="$keep" -v fresh="$fresh" -v sq="\047" '\''
  function peer(line,  f, rest) {
    sub(/^[ \t]+/, "", line)
    if (index(line, p) != 1) return 0
    rest = substr(line, length(p) + 1)
    if (rest !~ /^[ \t]/) return 0
    split(rest, f)
    key = f[2]
    name = f[3]
    return 1
  }
  {
    if (peer($0)) {
      if (name == "" || !index(keep, " " name " ") || index(fresh, " " key " ")) next
    } else {
      n = split($0, w)
      for (i = 1; i <= n; i++) taken[w[i]] = 1
    }
    print
  }
  END {
    n = split(ENVIRON["add"], lines, "\n")
    for (i = 1; i <= n; i++) {
      if (!peer(lines[i])) continue
      if (key in taken) {
        print "runner: " name sq "s key is on another line here, like the laptop" sq "s, so it gets no runner peer line" | "cat 1>&2"
        refused = 1
        continue
      }
      print lines[i]
    }
    exit refused ? 3 : 0
  }'\'' "$from" >"$new"
rc=$?
if [ "$rc" != 0 ] && [ "$rc" != 3 ]; then rm -f "$new"; exit 1; fi
mv -f "$new" "$k" || { rm -f "$new"; exit 1; }
exit "$rc"'

# A host `client/aws.sh up` made that a command finds stopped is started by
# the aws.sh beside this script, where client/install.sh puts it (README.md,
# Day to day). $up holds the hosts this run has reached, $stopped those it
# found stopped, and $starting those it found starting, a word each.
aws_sh=$(dirname "$0")/aws.sh
aws_failed=
up=
stopped=
starting=

# ssh hands the remote shell one string, so each argument is quoted for it:
# bare when it's only safe characters, else in single quotes, with ' as '\''.
# quote ARG sets $arg to ARG quoted.
q="'"
quote() {
  arg=$1
  case $arg in
  '' | *[![:alnum:]@%+=:,./_-]*)
    quoted=
    while :; do
      case $arg in
      *"$q"*)
        head=${arg%%"$q"*}
        arg=${arg#*"$q"}
        quoted=$quoted$head$q\\$q$q
        ;;
      *) break ;;
      esac
    done
    arg=$q$quoted$arg$q
    ;;
  esac
}

# A host's name, as runner shows it: the ssh target without its user@.
name_of() { printf '%s' "${1##*@}"; }

# aws_state HOST: sets $state to what AWS has HOST as, asking aws.sh by its
# name, as aws.sh up names the instance: pending, running, stopping, stopped,
# or none for a host aws.sh didn't make. Fails with no aws.sh, or when it
# can't say, as when signed out of AWS, once it has said why; it isn't asked
# again this run then. No stdin, so a command's is left for it.
aws_state() {
  state=
  if [ -n "$aws_failed" ] || [ ! -x "$aws_sh" ]; then return 1; fi
  if ! state=$(RUNNER_AWS_NAME=$(name_of "$1") "$aws_sh" state </dev/null); then
    aws_failed=1
    state=
    return 1
  fi
  case $state in
  pending | running | stopping | stopped | none) ;;
  *)
    state=
    return 1
    ;;
  esac
}

# ready HOST: before a command goes to HOST, starts it if it's stopped. Only
# a failure to connect counts, so a host this run hasn't reached is asked
# first, over BatchMode SSH, never the command's exit: ssh's 255 is also a
# command that couldn't run, or a session dropped as its host stopped, and a
# command that ran never runs again. One that doesn't answer is looked up
# with aws.sh, and started if AWS has it stopped or stopping, then waited
# for. With no aws.sh or AWS CLI here nothing is asked, as before. aws.sh's
# output goes to stderr, since stdout is the command's, MCP's JSON-RPC
# included. Fails only if a start does.
ready() {
  case " $up " in *" $1 "*) return 0 ;; esac
  case " $stopped " in
  *" $1 "*) state=stopped ;;
  *)
    if [ ! -x "$aws_sh" ] || ! command -v aws >/dev/null 2>&1; then return 0; fi
    # shellcheck disable=SC2086 # $ask is options, split.
    if ssh $ask "$1" true >/dev/null 2>&1; then
      up="$up $1"
      return 0
    fi
    # The command goes as it would have: ssh says why, or a passphrase
    # BatchMode can't type gets typed.
    aws_state "$1" || return 0
    case $state in pending | stopping | stopped) ;; *) return 0 ;; esac
    ;;
  esac
  case $state in pending) said=starting ;; *) said="stopped, so starting it" ;; esac
  echo "runner: $(name_of "$1") is $said with aws.sh start: a few minutes" >&2
  RUNNER_AWS_NAME=$(name_of "$1") "$aws_sh" start </dev/null >&2 || return 1
  others=
  for s in $stopped; do [ "$s" = "$1" ] || others="$others $s"; done
  stopped=$others
  # Booted, as AWS sees it, can come before Tailscale and sshd answer. The
  # command hasn't gone yet, so after a few minutes it goes anyway: a
  # passphrase BatchMode can't type gets typed, or ssh says what's wrong.
  tries=0
  # shellcheck disable=SC2086
  until ssh $ask "$1" true >/dev/null 2>&1; do
    tries=$((tries + 1))
    if [ "$tries" -ge 30 ]; then
      echo "runner: $(name_of "$1") is started, but hasn't answered BatchMode SSH for minutes, so the command goes as it is" >&2
      break
    fi
    sleep 2
  done
  up="$up $1"
}

# The hosts file's lines, the old host file's first line if there's no hosts
# file, or nothing, a host a line. RUNNER_HOST isn't in it: it's for this run.
saved_hosts() {
  if [ -e "$hosts_file" ]; then
    while read -r h _ || [ -n "$h" ]; do
      case $h in '' | '#'*) ;; *) printf '%s\n' "$h" ;; esac
    done <"$hosts_file"
  elif [ -r "$conf/host" ]; then
    read -r h <"$conf/host"
    [ -z "$h" ] || printf '%s\n' "$h"
  fi
}

# The host a line of the hosts file names: its first word, unless a comment.
host_in() {
  # shellcheck disable=SC2086 # split into words, never globbed (set -f).
  set -- $1
  case ${1-} in '#'*) ;; *) printf '%s' "${1-}" ;; esac
}

# Writes the hosts file from stdin, in one move.
save_hosts() {
  mkdir -p "$conf" &&
    cat >"$hosts_file.new.$$" &&
    mv -f "$hosts_file.new.$$" "$hosts_file"
}

# sane: refuses a listed host ssh would take for an option.
sane() {
  for h in $hosts; do
    case $h in -*)
      echo "runner: '$h' in ~/.config/runner/hosts isn't a host: give it as ssh takes it, like runner@kvm-host" >&2
      exit 2
      ;;
    esac
  done
}

# named NAME: sets $match to the host NAME names, as given or by its name.
named() {
  match=
  for nh in $hosts; do
    if [ "$nh" = "$1" ] || [ "$(name_of "$nh")" = "$1" ]; then
      match=$nh
      return 0
    fi
  done
  return 1
}

# Scratch space for every host's answers, and its removal however this ends;
# an exec ends without traps, so `clean` goes first.
tmp=
pids=
clean() {
  # shellcheck disable=SC2086 # pids are numbers, split.
  [ -z "$pids" ] || kill $pids 2>/dev/null
  pids=
  [ -z "$tmp" ] || rm -rf "$tmp"
  tmp=
}
scratch() {
  [ -z "$tmp" ] || return 0
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/runner.XXXXXX") || exit 1
  trap clean EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

# survey CMD: CMD on every host at once, with no stdin, prompt or long wait.
# Host i's stdout, stderr and exit code land in $tmp/i.out, .err and .rc.
survey() {
  scratch
  i=0
  for h in $hosts; do
    i=$((i + 1))
    # shellcheck disable=SC2086,SC2029 # $ask is options, split; $1 is for the host.
    ssh $ask "$h" "$1" >"$tmp/$i.out" 2>"$tmp/$i.err" &
    pids="$pids $!"
  done
  i=0
  for pid in $pids; do
    i=$((i + 1))
    wait "$pid"
    echo $? >"$tmp/$i.rc"
  done
  pids=
}

# answered CMD: after a survey of CMD, passes on each host's stderr, names
# each host that didn't answer or failed, and sets $failed if one did. One
# that didn't answer and AWS has stopped is named so, and noted in $stopped,
# or in $starting if it's starting, once each, but not started: the command
# that goes to it starts it, as it waits for one that's starting.
answered() {
  failed=
  i=0
  for h in $hosts; do
    i=$((i + 1))
    cat "$tmp/$i.err" >&2
    read -r rc <"$tmp/$i.rc"
    case $rc in
    0) up="$up $h" ;;
    255)
      aws_state "$h" || state=
      case $state in
      pending)
        case " $starting " in *" $h "*) ;; *) starting="$starting $h" ;; esac
        echo "runner: $(name_of "$h") is starting" >&2
        ;;
      stopping | stopped)
        case " $stopped " in *" $h "*) ;; *) stopped="$stopped $h" ;; esac
        echo "runner: $(name_of "$h") is $state" >&2
        ;;
      *) echo "runner: $(name_of "$h") didn't answer" >&2 ;;
      esac
      failed=1
      ;;
    *)
      echo "runner: \`$1\` failed on $(name_of "$h")" >&2
      failed=1
      ;;
    esac
  done
}

# recache SKIP: after a survey whose answers are each a host's list, after
# SKIP lines, the cache is what they list, and what a host that didn't
# answer had when last listed.
recache() {
  mkdir -p "${cache%/*}" || return
  i=0
  for h in $hosts; do
    i=$((i + 1))
    read -r rc <"$tmp/$i.rc"
    if [ "$rc" = 0 ]; then
      skip=$1
      while IFS= read -r line; do
        if [ "$skip" -gt 0 ]; then
          skip=$((skip - 1))
          continue
        fi
        [ "$line" != "no VMs yet" ] || continue
        v=${line%% *}
        case $v in '' | *[!a-z0-9-]*) continue ;; esac
        printf '%s %s\n' "$v" "$h"
      done <"$tmp/$i.out"
    elif [ -r "$cache" ]; then
      while read -r v c; do
        [ "$c" != "$h" ] || printf '%s %s\n' "$v" "$c"
      done <"$cache"
    fi
  done >"$cache.$$"
  mv -f "$cache.$$" "$cache"
}

# cached VM: sets $at to the host the cache has VM on, if it's still listed.
cached() {
  at=
  [ -r "$cache" ] || return 0
  while read -r v h; do
    if [ "$v" = "$1" ] && named "$h"; then
      at=$h
      return 0
    fi
  done <"$cache"
}

# remember VM HOST, and forget VM, keep the cache in step with a create,
# import or delete.
forget() {
  [ -r "$cache" ] || return 0
  while read -r v h; do
    [ "$v" = "$1" ] || printf '%s %s\n' "$v" "$h"
  done <"$cache" >"$cache.$$"
  mv -f "$cache.$$" "$cache"
}
remember() {
  mkdir -p "${cache%/*}" || return
  forget "$1"
  printf '%s %s\n' "$1" "$2" >>"$cache"
}

# locate VM: sets $at to the host that has VM: the one --host names, the
# first for base, the cache's once that host says it has it, else where
# every host's list finds it now. Empty if no host has it.
locate() {
  if [ -n "$via" ]; then
    at=$via
    return
  fi
  if [ "$1" = base ]; then
    at=$first
    return
  fi
  cached "$1"
  if [ -n "$at" ]; then
    # Apart from the command and with no stdin, so a miss takes none of it.
    quote "$1"
    # shellcheck disable=SC2086,SC2029 # $ask is options, split; $arg is quoted for the host.
    if ssh $ask "$at" "runner ip $arg" >/dev/null 2>&1; then
      up="$up $at"
      return
    fi
  fi
  survey "runner list"
  answered "runner list"
  recache 0
  cached "$1"
}

# held VM: sets $at to the host that has VM, as locate does, for a command
# that makes VM when no host has it. --host can't make a second of one
# another host has, so that's refused; base is on every host, so --host
# says which. Empty if no host has it.
held() {
  given=$via
  via=
  locate "$1"
  via=$given
  [ -n "$at" ] || return 0
  if [ -n "$via" ] && [ "$at" != "$via" ] && [ "$1" != base ]; then
    echo "runner: $(name_of "$at") has a VM named $1 already: VM names are one per name across hosts" >&2
    exit 1
  fi
  at=${via:-$at}
}

# mib SIZE: sets $mib to SIZE in MiB, as the host's runner reads a memory
# size: MiB, or a whole number with M, G or T (src/store.rs). Fails on one it
# wouldn't take, or one too big to count here.
mib() {
  mib=
  digits=${1%%[!0-9]*}
  suffix=${1#"$digits"}
  # No leading zeros, which sh's arithmetic reads as octal.
  while :; do
    case $digits in 0?*) digits=${digits#0} ;; *) break ;; esac
  done
  case $digits in '' | 0 | ??????????*) return 1 ;; esac
  case $suffix in
  '' | [mM] | [mM][iI][bB]) mib=$digits ;;
  [gG] | [gG][iI][bB]) mib=$((digits * 1024)) ;;
  [tT] | [tT][iI][bB]) mib=$((digits * 1048576)) ;;
  *) return 1 ;;
  esac
  # It takes no more MiB than a u32 holds.
  [ "$mib" -le 4294967295 ] || {
    mib=
    return 1
  }
}

# mem_of LINE: sets $mib to the memory a line of `runner list` gives its VM,
# its word after mem.
mem_of() {
  # shellcheck disable=SC2086 # split into words, never globbed (set -f).
  set -- $1
  # Past its name, which could be mem.
  shift
  while [ $# -gt 1 ]; do
    if [ "$1" = mem ]; then
      mib "$2"
      return
    fi
    shift
  done
  return 1
}

# gib BYTES [up]: BYTES in GiB to a tenth, like 4.1G, rounded down, or up
# with up, as a host's refusal has them, so a need never reads as if it fit.
gib() {
  if [ -n "${2-}" ]; then
    t=$((($1 * 10 + 1073741823) / 1073741824))
  else
    t=$(($1 * 10 / 1073741824))
  fi
  printf '%s.%sG' $((t / 10)) $((t % 10))
}

# needs: after a survey of rows and lists, sets $need to the bytes a new VM
# from base needs to boot (src/room.rs): its memory, --mem's, else base's on
# the first host that listed it, else the host's 2G, and 64 MiB for its
# Firecracker. Fails on a --mem the host's runner would refuse itself.
needs() {
  need=
  if [ -n "$mem" ]; then
    mib "$mem" || return 1
  else
    mib=
    i=0
    for h in $hosts; do
      i=$((i + 1))
      read -r rc <"$tmp/$i.rc"
      [ "$rc" = 0 ] || continue
      while IFS= read -r line; do
        case $line in "base "*) mem_of "$line" && break 2 ;; esac
      done <"$tmp/$i.out"
    done
    [ -n "$mib" ] || mib=2048
  fi
  need=$(((mib + 64) * 1048576))
}

# taken NAME: refuses NAME if a host has a VM of that name, counting the VMs
# a host that doesn't answer had when last listed. base is on every host.
taken() {
  [ "$1" != base ] || return 0
  cached "$1"
  [ -n "$at" ] || return 0
  echo "runner: $(name_of "$at") has a VM named $1 already: VM names are one per name across hosts" >&2
  exit 1
}

# room_of I: sets $free to host I's room, in bytes, from its row in the
# survey; empty if it didn't answer or say.
room_of() {
  free=
  read -r rc <"$tmp/$1.rc"
  [ "$rc" = 0 ] || return 0
  read -r _ _ _ _ free _ <"$tmp/$1.out"
  case $free in '' | *[!0-9]*) free= ;; esac
}

# pick NAME: sets $at to the host a new VM NAME goes to: the one --host
# names, the first for base, the host of a VM other than base it forks, else
# the one with the most free memory, if NAME has room there. If none has,
# a host already starting is waited for, then the stopped hosts are started
# one at a time, in the hosts file's order, until one has (README.md,
# Several hosts); if none does, it's refused, naming each host's room.
# Refuses a name any host has.
pick() {
  survey "runner hosts && runner list"
  answered "runner hosts && runner list"
  recache 1
  taken "$1"
  if [ -n "$via" ]; then
    at=$via
    return
  fi
  if [ "$1" = base ]; then
    at=$first
    return
  fi
  if [ -n "$from" ] && [ "$from" != base ]; then
    cached "$from"
    [ -z "$at" ] || return 0
  fi
  at=
  most=
  i=0
  for h in $hosts; do
    i=$((i + 1))
    room_of "$i"
    [ -n "$free" ] || continue
    if [ -z "$at" ] || [ "$free" -gt "$most" ]; then
      at=$h
      most=$free
    fi
  done
  # An import is as big as its export, which only the host reads, and a
  # fork of a VM no host has is the host's to refuse: neither starts a host.
  if [ "$cmd" = import ] || { [ -n "$from" ] && [ "$from" != base ]; } || ! needs; then
    [ -n "$at" ] && return 0
    echo "runner: no host answered, so $1 has nowhere to go" >&2
    exit 1
  fi
  if [ -n "$at" ] && [ "$most" -ge "$need" ]; then return 0; fi
  # A stopped host's room is known once it answers. ready takes it out of
  # $stopped, which the loop has read; ready and needs have loops of their
  # own, so these are named apart.
  for cold in $starting $stopped; do
    case " $starting " in
    *" $cold "*) doing="waiting for $(name_of "$cold"), which is starting" ;;
    *) doing="starting $(name_of "$cold")" ;;
    esac
    echo "runner: no running host has $(gib "$need" up) free; $doing" >&2
    ready "$cold" || exit 255
    k=0
    for h in $hosts; do
      k=$((k + 1))
      [ "$h" != "$cold" ] || break
    done
    # shellcheck disable=SC2086 # $ask is options, split.
    ssh $ask "$cold" "runner hosts && runner list" >"$tmp/$k.out" 2>"$tmp/$k.err"
    echo $? >"$tmp/$k.rc"
    cat "$tmp/$k.err" >&2
    recache 1
    taken "$1"
    # Base's memory, if no host had answered before.
    needs
    room_of "$k"
    # Starting the next would leave this one up with nothing on it.
    if [ -z "$free" ]; then
      echo "runner: $(name_of "$cold") is started, but didn't say its room: run it again once it answers" >&2
      exit 1
    fi
    if [ "$free" -ge "$need" ]; then
      at=$cold
      return 0
    fi
  done
  width=0
  any=
  i=0
  for h in $hosts; do
    i=$((i + 1))
    hn=$(name_of "$h")
    [ "${#hn}" -le "$width" ] || width=${#hn}
    room_of "$i"
    [ -z "$free" ] || any=1
  done
  # The network, say, not room.
  if [ -z "$any" ]; then
    echo "runner: no host answered, so $1 has nowhere to go" >&2
    exit 1
  fi
  {
    echo "runner: no host has room for $1, which needs $(gib "$need" up):"
    i=0
    for h in $hosts; do
      i=$((i + 1))
      room_of "$i"
      if [ -n "$free" ]; then room="$(gib "$free") free"; else room="didn't answer"; fi
      printf "  %-${width}s  %s\n" "$(name_of "$h")" "$room"
    done
    echo "Stop or sleep a VM on one, or add a host: \`RUNNER_AWS_NAME=<name> client/aws.sh up\`, then \`runner hosts add runner@<name>\`."
  } >&2
  exit 1
}

# go HOST [keep]: the command on HOST, with a terminal only when typed at
# one, then exit with its exit code. With keep, return it instead. A host
# found stopped is started first.
go() {
  h=$1
  keep=${2-}
  if [ "$cmd" = mcp ]; then
    # No terminal, so stdout carries only JSON-RPC, and no prompt to hang the client.
    set -- -T -o BatchMode=yes
  elif [ "$cmd" = export ] && [ -t 1 ]; then
    # The host refuses a terminal on an export's stdout, so it has to see this
    # one, even when stdin isn't one: -tt.
    set -- -tt -o LogLevel=ERROR
  elif [ -t 0 ] && [ -t 1 ]; then
    # A tty only when typed at one: piped output would get CRLF and stderr mixed in.
    # LogLevel=ERROR drops ssh's "Connection to … closed." after every command.
    set -- -t -o LogLevel=ERROR
  else
    set --
  fi
  ready "$h" || exit 255
  # shellcheck disable=SC2029 # $remote is quoted for the host's shell, here.
  if [ -z "$keep" ]; then
    clean
    exec ssh "$@" "$h" "$remote"
  fi
  # shellcheck disable=SC2029
  ssh "$@" "$h" "$remote"
}

# reconcile HOST KEEP FRESH ADD: `edit` on HOST with those, BatchMode and
# with no stdin, passing on what it says. Returns 1 if it didn't answer or
# failed, naming HOST and what's left as it was, $left, or if it refused a
# line.
reconcile() {
  # Not a host, so there's nothing on it to change.
  case $1 in -*) return 0 ;; esac
  quote "$peer_opts"
  c="p=$arg"
  quote " $2 "
  c="$c keep=$arg"
  quote " $3 "
  c="$c fresh=$arg"
  quote "$4"
  c="$c add=$arg; $edit"
  # shellcheck disable=SC2086,SC2029 # $ask is options, split; $c is for the host.
  ssh $ask "$1" "$c"
  case $? in
  0) return 0 ;;
  # It said why, and changed the rest.
  3) ;;
  255) echo "runner: $(name_of "$1") didn't answer, so $left" >&2 ;;
  *) echo "runner: $(name_of "$1") couldn't change ~runner/.ssh/authorized_keys, so $left" >&2 ;;
  esac
  return 1
}

# relist HOST [LISTED]...: HOST's runner gets LISTED as the hosts as listed,
# the first first, which its MCP over HTTP reads at each call as `runner mcp`
# takes --name and --peer; with none, it has no list. BatchMode, with no
# stdin, and what the host says isn't passed on, since an older runner's
# usage would bury the one line here. Returns 1 if it didn't answer or
# failed, naming HOST and what's left, $left.
relist() {
  # Not a host, so there's nothing on it to change.
  case $1 in -*) return 0 ;; esac
  on=$1
  shift
  c='runner mcp-http peers'
  for l; do
    # Nor is a line ssh would take for an option one to reach.
    case $l in -*) continue ;; esac
    quote "$l"
    c="$c $arg"
  done
  # shellcheck disable=SC2086,SC2029 # $ask is options, split; $c is for the host.
  ssh $ask "$on" "$c" >/dev/null 2>&1
  case $? in
  0) return 0 ;;
  255) echo "runner: $(name_of "$on") didn't answer, so $left" >&2 ;;
  *) echo "runner: \`runner mcp-http peers\` failed on $(name_of "$on") (an older runner?), so $left" >&2 ;;
  esac
  return 1
}

# share: every listed host's key on every other host, so each drives the
# others' runners through `runner peer`: each host that answers gets a line
# for every other host whose key came, in place of any it had for that host
# or that key, and keeps the lines of listed hosts whose key didn't come;
# a line for a host that isn't listed goes. The first host gets the list for
# its MCP over HTTP. Then exits, 1 if a host didn't answer, had no key or
# couldn't take the lines, or the first couldn't take the list.
share() {
  sane
  scratch
  failed=
  n=0
  for h in $hosts; do n=$((n + 1)); done
  if [ "$n" -gt 1 ]; then
    survey 'cat ~/.ssh/id_ed25519.pub'
    i=0
    for h in $hosts; do
      i=$((i + 1))
      read -r rc <"$tmp/$i.rc"
      if [ "$rc" = 255 ]; then
        echo "runner: $(name_of "$h") didn't answer, so its key and the others' lines on it are as they were" >&2
        failed=1
        continue
      fi
      t='' k=''
      [ "$rc" != 0 ] || read -r t k _ <"$tmp/$i.out"
      # A bare ed25519 key, so a host can't slip options or another line in.
      case $t:$k in
      ssh-ed25519:AAAAC3NzaC1lZDI1NTE5*)
        case $k in *[!A-Za-z0-9+/=]*) ;; *)
          printf '%s\n' "$k" >"$tmp/$i.key"
          continue
          ;;
        esac
        ;;
      esac
      echo "runner: $(name_of "$h") has no SSH key in ~runner/.ssh/id_ed25519.pub that's a plain ed25519 one, so the others can't trust it: rerun host/install.sh there, then \`runner hosts add $h\`" >&2
      failed=1
    done
    # One key for two hosts, say one cloned from the other's disk, can't
    # tell them apart, so neither would get a line for the other.
    i=0
    for h in $hosts; do
      i=$((i + 1))
      [ -r "$tmp/$i.key" ] || continue
      read -r a <"$tmp/$i.key"
      j=0
      for p in $hosts; do
        j=$((j + 1))
        if [ "$j" -le "$i" ] || [ ! -r "$tmp/$j.key" ]; then continue; fi
        read -r b <"$tmp/$j.key"
        [ "$a" = "$b" ] || continue
        echo "runner: $(name_of "$h") and $(name_of "$p") have the same key, so neither can trust the other by it: if they're two hosts, give one a new key (remove ~runner/.ssh/id_ed25519 there and rerun host/install.sh), then \`runner hosts add\` again" >&2
        failed=1
      done
    done
  fi
  left="its authorized_keys is as it was: \`runner hosts add\` again once it answers"
  i=0
  for h in $hosts; do
    i=$((i + 1))
    if [ "$n" -gt 1 ]; then
      read -r rc <"$tmp/$i.rc"
      [ "$rc" != 255 ] || continue
    fi
    mine=
    [ ! -r "$tmp/$i.key" ] || read -r mine <"$tmp/$i.key"
    keep='' fresh='' add=''
    j=0
    for p in $hosts; do
      j=$((j + 1))
      [ "$j" != "$i" ] || continue
      if [ -r "$tmp/$j.key" ]; then
        read -r k <"$tmp/$j.key"
        fresh="$fresh $k"
        # No line for its own key: the same host listed twice.
        [ "$k" = "$mine" ] || add="${add:+$add$nl}$peer_opts ssh-ed25519 $k $(name_of "$p")"
      else
        keep="$keep $(name_of "$p")"
      fi
    done
    reconcile "$h" "$keep" "$fresh" "$add" || failed=1
  done
  top=${hosts%%"$nl"*}
  left="MCP over HTTP there won't reach the hosts as listed until \`runner hosts add $top\` again"
  # shellcheck disable=SC2086 # a host a word, never globbed (set -f).
  relist "$top" $hosts || failed=1
  [ -z "$failed" ] || exit 1
  if [ "$n" -gt 1 ]; then
    echo "shared keys: each of$(for h in $hosts; do printf ' %s' "$(name_of "$h")"; done) drives the others' runners"
  fi
  exit 0
}

if [ "${1-}" = hosts ]; then
  case $# in
  1)
    if [ -n "${RUNNER_HOST-}" ]; then hosts=$RUNNER_HOST; else hosts=$(saved_hosts); fi
    if [ -z "$hosts" ]; then
      echo "runner: no hosts yet: \`runner hosts add runner@kvm-host\` adds one" >&2
      exit 2
    fi
    for h in $hosts; do
      case $h in -*)
        echo "runner: '$h' isn't a host: give it as ssh takes it, like runner@kvm-host" >&2
        exit 2
        ;;
      esac
    done
    survey "runner hosts"
    i=0
    for h in $hosts; do
      i=$((i + 1))
      read -r rc <"$tmp/$i.rc"
      [ "$rc" != 0 ] || printf '%s  %s\n' "$(name_of "$h")" "$(cat "$tmp/$i.out")"
    done
    answered "runner hosts"
    [ -z "$failed" ] || exit 1
    exit 0
    ;;
  2)
    case $2 in -h | --help)
      echo "$hosts_usage"
      exit 0
      ;;
    esac
    ;;
  3)
    hosts=$(saved_hosts)
    case $2 in
    add)
      case $3 in '' | -*)
        echo "runner: '$3' isn't a host: give it as ssh takes it, like runner@kvm-host-2" >&2
        exit 2
        ;;
      esac
      sane
      if named "$3" && [ "$match" = "$3" ]; then
        echo "runner: $3 is on the list already"
        hosts=$(saved_hosts)
        share
      fi
      if named "$(name_of "$3")"; then
        echo "runner: $(name_of "$3") is on the list already, as $match: \`runner hosts rm $match\` first to change it" >&2
        exit 1
      fi
      # Prompts allowed, so ssh can ask to take a new host's key.
      if ! row=$(ssh -n -o ConnectTimeout="$wait" "$3" "runner hosts"); then
        echo "runner: $3 didn't answer \`runner hosts\`, so it isn't added" >&2
        exit 1
      fi
      {
        # A line at a time, since a last line edited by hand may have no newline.
        if [ -e "$hosts_file" ]; then
          while IFS= read -r line || [ -n "$line" ]; do
            printf '%s\n' "$line"
          done <"$hosts_file"
        elif [ -n "$hosts" ]; then
          printf '%s\n' "$hosts"
        fi
        printf '%s\n' "$3"
      } | save_hosts || exit 1
      echo "added $3: $row"
      hosts=$(saved_hosts)
      share
      ;;
    rm)
      if ! named "$3"; then
        echo "runner: no host $3 in ~/.config/runner/hosts" >&2
        exit 1
      fi
      if [ -e "$hosts_file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
          [ "$(host_in "$line")" = "$match" ] || printf '%s\n' "$line"
        done <"$hosts_file"
      else
        for h in $hosts; do
          [ "$h" = "$match" ] || printf '%s\n' "$h"
        done
      fi | save_hosts || exit 1
      echo "removed $match"
      # The rest drop its line, keeping each other's; then it drops theirs.
      gone=$match
      was=${hosts%%"$nl"*}
      hosts=$(saved_hosts)
      failed=
      keep=
      for h in $hosts; do keep="$keep $(name_of "$h")"; done
      for h in $hosts; do
        left="$(name_of "$gone")'s key still works there: \`runner hosts add $h\` takes it out once it answers"
        reconcile "$h" "$keep" "" "" || failed=1
      done
      if [ -n "$hosts" ]; then
        left="the other hosts' keys still work there"
        reconcile "$gone" "" "" "" || failed=1
        # The first, maybe a new one, gets the list for its MCP over HTTP.
        top=${hosts%%"$nl"*}
        left="MCP over HTTP there won't reach the hosts as listed until \`runner hosts add $top\` again"
        # shellcheck disable=SC2086 # a host a word, never globbed (set -f).
        relist "$top" $hosts || failed=1
      fi
      # One that was first has no list. It's off the list, so one it keeps
      # is only said.
      if [ "$gone" = "$was" ]; then
        left="MCP over HTTP there still has the old list: \`RUNNER_HOST=$gone runner mcp-http peers\` clears it"
        relist "$gone" || :
      fi
      [ -z "$failed" ] || exit 1
      exit 0
      ;;
    esac
    ;;
  esac
  echo "$hosts_usage" >&2
  exit 2
fi

# The command, the VM it names, and the laptop's --host, found past options
# and their values, and up to a `--`, after which every argument is the
# command's own. --host comes out: the host's runner hasn't got it. move's
# target is $to, and $spot its place among the arguments kept, so only it
# becomes its listed form, not an option's value that reads the same.
cmd='' sub='' vm='' run='' from='' mem='' via='' replace='' takes='' ended='' extra='' to='' spot='' tries=''
n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  if [ -n "$ended" ]; then
    # A VM can come after a `--` too, as clap has it, and so can a target.
    if [ "$ended" = 1 ] && [ -z "$vm" ] && [ -n "$cmd" ] && { [ "$cmd" != service ] || [ -n "$sub" ]; }; then
      vm=$a
    elif [ "$cmd" = move ] && [ -n "$vm" ] && [ -z "$to" ]; then
      to=$a
      spot=$(($# - n + 1))
    fi
    ended=2
    set -- "$@" "$a"
    continue
  fi
  # What follows a VM for run, attach and kill takes hyphens as it comes,
  # so a prompt or session of --host is theirs.
  if [ -n "$vm" ] && [ -z "$extra" ] && [ -z "$takes" ]; then
    case $cmd:$a in run:--host | run:--host=* | attach:--host | attach:--host=* | kill:--host | kill:--host=*)
      extra=1
      set -- "$@" "$a"
      continue
      ;;
    esac
  fi
  if [ -n "$takes" ]; then
    case $takes in
    --host)
      via=$a
      takes=
      continue
      ;;
    --from) from=$a ;;
    --mem) mem=$a ;;
    --run) run=$a ;;
    --n) tries=$a ;;
    esac
    takes=
    set -- "$@" "$a"
    continue
  fi
  case $a in
  --) ended=1 ;;
  --host)
    takes=--host
    continue
    ;;
  --host=?*)
    via=${a#--host=}
    continue
    ;;
  --host=)
    takes=--host
    break
    ;;
  --from=*) from=${a#*=} ;;
  --mem=*) mem=${a#*=} ;;
  --run=*) run=${a#*=} ;;
  --n=*) tries=${a#*=} ;;
  --replace) replace=1 ;;
  --*=*) ;;
  --*) case $valued in *" $a "*) takes=$a ;; esac ;;
  -?*)
    # A cluster like -fn: its first letter that takes a value takes the rest,
    # or the next argument if it's last.
    rest=${a#-}
    while [ -n "$rest" ]; do
      c=${rest%"${rest#?}"}
      rest=${rest#?}
      case $valued in *" -$c "*)
        [ -n "$rest" ] || takes=-$c
        break
        ;;
      esac
    done
    ;;
  *)
    if [ -z "$cmd" ]; then
      cmd=$a
    elif [ "$cmd" = service ] && [ -z "$sub" ]; then
      sub=$a
    elif [ -z "$vm" ]; then
      vm=$a
    else
      # $# - n arguments are kept so far, so this one is the next.
      if [ "$cmd" = move ] && [ -z "$to" ]; then
        to=$a
        spot=$(($# - n + 1))
      fi
      # exec's program, and service add's after the service's name, take
      # every argument after them as theirs, --host included.
      extra=$((extra + 1))
      if [ "$cmd" = exec ] || { [ "$cmd:$sub" = service:add ] && [ "$extra" -ge 2 ]; }; then
        ended=2
      fi
    fi
    ;;
  esac
  set -- "$@" "$a"
done
if [ "$takes" = --host ]; then
  echo "runner: --host needs a host: one in ~/.config/runner/hosts, like --host kvm-host-2" >&2
  exit 2
fi

# RUNNER_HOST, and the old host file's first line, are one host, as given.
# Each of the hosts file's lines is one more.
several=
if [ -n "${RUNNER_HOST-}" ] || [ ! -e "$hosts_file" ]; then
  first=${RUNNER_HOST-}
  [ -n "$first" ] || first=$(saved_hosts)
  hosts=$first
else
  hosts=$(saved_hosts)
  first=
  for h in $hosts; do
    case $h in -*)
      echo "runner: '$h' in ~/.config/runner/hosts isn't a host: give it as ssh takes it, like runner@kvm-host" >&2
      exit 2
      ;;
    esac
    if [ -z "$first" ]; then first=$h; else several=1; fi
  done
fi
if [ -z "$first" ] && [ -z "${RUNNER_HOST-}" ] && [ -e "$hosts_file" ]; then
  echo "runner: no host in ~/.config/runner/hosts: \`runner hosts add <host>\` adds one" >&2
  exit 2
fi
case $first in
'' | -*)
  echo "runner: no host. Set RUNNER_HOST, or put it in ~/.config/runner/host (client/install.sh <host> does); \`runner hosts add <host>\` lists more in ~/.config/runner/hosts." >&2
  exit 2
  ;;
esac
if [ -n "$via" ]; then
  if ! named "$via"; then
    echo "runner: --host $via isn't one of the hosts: $(for h in $hosts; do printf '%s ' "$(name_of "$h")"; done)" >&2
    exit 2
  fi
  via=$match
fi
host=${via:-$first}

# proxy runs here, not on the host: localhost:PORT on the laptop becomes PORT
# in the VM, through an ssh tunnel to the host, which reaches the VM's address.
# The tunnel's command is the host's `runner hold`, which holds the VM in use
# until the connection closes, so the VM doesn't idle-sleep under the proxy.
usage="usage: runner proxy <vm> <port>|<local>:<remote>...
  runner proxy dev 3000         localhost:3000 here is dev's port 3000
  runner proxy dev 8080:3000    localhost:8080 here is dev's port 3000"

# port P: whether P is 1 to 65535, written without leading zeros.
port() {
  case $1 in '' | 0* | *[!0-9]* | ??????*) return 1 ;; esac
  [ "$1" -le 65535 ]
}

if [ "${1-}" = proxy ]; then
  case ${2-} in -h | --help)
    echo "$usage"
    exit 0
    ;;
  esac
  if [ $# -lt 3 ] || [ -z "$2" ]; then
    echo "$usage" >&2
    exit 2
  fi
  vm=$2
  shift 2
  for spec; do
    if ! port "${spec%%:*}" || ! port "${spec#*:}"; then
      printf "runner: '%s' isn't a port or local:remote\n%s\n" "$spec" "$usage" >&2
      exit 2
    fi
  done
  if [ -n "$several" ]; then
    locate "$vm"
    host=${at:-$first}
    clean
  fi

  # start boots a stopped VM, wakes a sleeping one, and leaves a running one be.
  quote "$vm"
  vmq=$arg
  # A stopped host is started first. No stdin, so keys typed while the VM
  # boots stay in the terminal, and no tty, whose \r would spoil the address.
  ready "$host" || exit 255
  # shellcheck disable=SC2029 # $vmq is quoted for the host's shell, here.
  addr=$(ssh -n -T "$host" "runner start $vmq >/dev/null && runner ip $vmq") || exit
  case $addr in '' | *[!0-9.]*)
    echo "runner: the host gave $vm's address as '$addr', which isn't one" >&2
    exit 1
    ;;
  esac
  said=
  for spec; do
    shift
    lport=${spec%%:*}
    rport=${spec#*:}
    # localhost binds loopback alone, even with GatewayPorts set.
    set -- "$@" -L "localhost:$lport:$addr:$rport"
    said="$said, localhost:$lport is $vm's port $rport"
  done
  echo "runner: ${said#, }. Ctrl-C ends it." >&2
  # The hold reads nothing, so no stdin, and keys typed here go nowhere. Ctrl-C
  # or a dropped connection ends ssh, and with it the hold, so the VM's idle
  # time starts again.
  # shellcheck disable=SC2029 # $vmq is quoted for the host's shell, here.
  exec ssh -n -T -o ExitOnForwardFailure=yes "$@" "$host" "runner hold $vmq"
fi

remote=runner
for a; do
  quote "$a"
  remote="$remote $arg"
done

# One host: everything goes there, as it always has.
[ -n "$several" ] || go "$host"

# MCP is one session, to the first host or the one --host names, whose
# runner reaches every other host as a peer, and calls itself by the name
# it's listed by (README.md, MCP clients).
if [ "$cmd" = mcp ]; then
  quote "$host"
  remote="$remote --name $arg"
  for h in $hosts; do
    [ "$h" != "$host" ] || continue
    quote "$h"
    remote="$remote --peer $arg"
  done
  go "$host"
fi

case $cmd in
mcp-http)
  # Names no VM, whatever the scan took for one: token, pair, list and
  # revoke are for the MCP over HTTP of the first host, or the one --host
  # names.
  go "$host"
  ;;
list)
  [ -z "$via" ] || go "$via"
  survey "$remote"
  any=
  i=0
  for h in $hosts; do
    i=$((i + 1))
    read -r rc <"$tmp/$i.rc"
    [ "$rc" = 0 ] || continue
    while IFS= read -r line; do
      [ "$line" != "no VMs yet" ] || continue
      printf '%s  %s\n' "$(name_of "$h")" "$line"
      any=1
    done <"$tmp/$i.out"
  done
  answered "$remote"
  recache 0
  [ -n "$any" ] || [ -n "$failed" ] || echo "no VMs yet"
  [ -z "$failed" ] || exit 1
  exit 0
  ;;
doctor | gc)
  if [ -n "$via" ] || { [ "$cmd" = gc ] && [ -n "$vm" ]; }; then
    locate "$vm"
    go "${at:-$first}"
  fi
  survey "$remote"
  i=0
  for h in $hosts; do
    i=$((i + 1))
    while IFS= read -r line; do
      printf '%s  %s\n' "$(name_of "$h")" "$line"
    done <"$tmp/$i.out"
  done
  answered "$remote"
  [ -z "$failed" ] || exit 1
  exit 0
  ;;
create | import)
  [ -n "$vm" ] || go "$host"
  if [ "$cmd" = import ] && [ -n "$replace" ]; then
    # On top of the VM where it is; a name no host has is imported anew.
    held "$vm"
    [ -z "$at" ] || go "$at"
  fi
  pick "$vm"
  go "$at" keep
  rc=$?
  [ "$rc" != 0 ] || remember "$vm" "$at"
  exit "$rc"
  ;;
delete)
  [ -n "$vm" ] || go "$host"
  locate "$vm"
  go "${at:-$first}" keep
  rc=$?
  [ "$rc" != 0 ] || forget "$vm"
  exit "$rc"
  ;;
move)
  [ -n "$to" ] || go "$host"
  if ! named "$to"; then
    echo "runner: $to isn't one of the hosts: $(for h in $hosts; do printf '%s ' "$(name_of "$h")"; done)" >&2
    exit 2
  fi
  to=$match
  locate "$vm"
  [ -n "$at" ] || go "$first"
  if [ "$(name_of "$at")" = "$(name_of "$to")" ]; then
    echo "runner: $vm is on $(name_of "$to") already" >&2
    exit 1
  fi
  # The VM's host streams it to the target, so a stopped target starts first.
  ready "$to" || exit 255
  # The VM's host gets the target as listed, which its ssh reaches.
  remote=runner
  i=0
  for a; do
    i=$((i + 1))
    [ "$i" != "$spot" ] || a=$to
    quote "$a"
    remote="$remote $arg"
  done
  go "$at" keep
  rc=$?
  [ "$rc" != 0 ] || remember "$vm" "$to"
  exit "$rc"
  ;;
claude)
  if [ -n "$run" ]; then
    locate "${run%.*}"
    go "${at:-$first}"
  fi
  [ -n "$vm" ] || go "$host"
  # A new VM, which claude makes, goes where create would put it.
  held "$vm"
  [ -z "$at" ] || go "$at"
  pick "$vm"
  go "$at"
  ;;
output | result | cancel)
  [ -n "$vm" ] || go "$host"
  locate "${vm%.*}"
  go "${at:-$first}"
  ;;
run)
  [ -n "$vm" ] || go "$host"
  locate "$vm"
  # Best of N makes VM-1 to VM-N on VM's host, which refuses a name it has;
  # one another host has is refused here. Any other N is the host's to refuse.
  case $tries in 2 | 3 | 4)
    if [ -n "$at" ]; then
      home=$at
      survey "runner list"
      answered "runner list"
      recache 0
      i=1
      while [ "$i" -le "$tries" ]; do
        cached "$vm-$i"
        if [ -n "$at" ] && [ "$at" != "$home" ]; then
          echo "runner: $(name_of "$at") has a VM named $vm-$i already: VM names are one per name across hosts" >&2
          exit 1
        fi
        i=$((i + 1))
      done
      at=$home
    fi
    ;;
  esac
  go "${at:-$first}"
  ;;
export | start | stop | status | sleep | wake | idle | url | net | logs | undo | resize | rebase | checkpoint | checkpoints | restore | creds | ip | shell | sessions | attach | kill | service | exec | runs | tries | keep | hold)
  [ -n "$vm" ] || go "$host"
  locate "$vm"
  go "${at:-$first}"
  ;;
esac
go "$host"
